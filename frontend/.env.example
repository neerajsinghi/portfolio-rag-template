# Copy to frontend/.env.local for local development.
# All NEXT_PUBLIC_* values are inlined at build time.

# URL of the Go backend the browser calls for chat + GitHub data
NEXT_PUBLIC_API_BASE=http://localhost:8080

# Public URL of the deployed site (canonical URLs, sitemap, Open Graph).
# Defaults to SITE.url in lib/profile.ts when unset.
NEXT_PUBLIC_SITE_URL=

# Optional Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave empty to disable.
NEXT_PUBLIC_GA_ID=
