# Copy to backend/.env and fill in. Only the key for your chosen provider is required.

# ── LLM provider ─────────────────────────────────────────────────────────────
# One of: anthropic (default) | openai | grok | gemini
LLM_PROVIDER=anthropic

# Anthropic (LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_HTTP_TIMEOUT=45s

# OpenAI (LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# xAI Grok (LLM_PROVIDER=grok)
XAI_API_KEY=
GROK_MODEL=grok-3

# Google Gemini (LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Knowledge base ───────────────────────────────────────────────────────────
# Folder with profile.json + Markdown documents (see corpus/README.md)
CORPUS_DIR=corpus

# ── GitHub strip / get_github_repos tool ────────────────────────────────────
# Your GitHub username. Leave empty to disable the live repo strip.
GITHUB_USER=
# Optional: a read-only token raises the GitHub API rate limit
GITHUB_TOKEN=

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8080
# Comma-separated list of frontend origins allowed by CORS ("*" if empty)
ALLOWED_ORIGIN=http://localhost:3000
